{
  "name": "ai-photo-culling",
  "productName": "AI Photo Culling",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "backend:build": "node scripts/build-backend.cjs",
    "electron:dev": "node scripts/electron-dev.cjs",
    "package": "npm run build && npm run backend:build && node scripts/package-electron.cjs --mac",
    "package:dmg": "npm run build && npm run backend:build && node scripts/package-electron.cjs --mac dmg",
    "package:dir": "npm run build && npm run backend:build && node scripts/package-electron.cjs --dir",
    "preview": "vite preview",
    "test": "vitest run",
    "package:win": "npm run build && npm run backend:build && node scripts/package-electron.cjs --win msi --x64"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.3",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.ai-photo-culling.app",
    "productName": "AI Photo Culling",
    "asar": true,
    "directories": {
      "output": "../release",
      "buildResources": "electron/assets"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/backend",
        "to": "backend",
        "filter": [
          "ai-culling-backend",
          "ai-culling-backend.exe"
        ]
      },
      {
        "from": "..",
        "to": "runtime-source",
        "filter": [
          "app.py",
          "server/**/*",
          "static/**/*",
          "templates/**/*",
          "requirements.txt",
          "requirements-ai.txt",
          "requirements-faiss.txt"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.photography",
      "icon": "icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "icon-win.png",
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../build/vc-runtime",
          "to": "vc-runtime",
          "filter": [
            "*.dll"
          ]
        }
      ]
    },
    "msi": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "upgradeCode": "DF213409-AE4E-42C4-9CD2-E7A1AAF7845E",
      "artifactName": "${productName} ${version} x64.${ext}"
    }
  }
}
